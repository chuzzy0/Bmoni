# Meta WhatsApp Cloud API
# Found in Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=1229579623568388
WHATSAPP_ACCESS_TOKEN=your_meta_user_or_system_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=bmoni_whatsapp_verify_token_123

# Optional: Meta App ID (used for Resumable Upload API fallback if required)
WHATSAPP_APP_ID=

# BMONI Embedded API
BMONI_API_KEY=
BMONI_BASE_URL=https://embedded-dev.bmoni.com

# Encryption key for stored private keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Server
PORT=3000
